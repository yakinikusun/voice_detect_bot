# DISCORD側の設定
TOKEN=                  # Discord Botのトークン
VOICE_CHANNEL_ID=       # 音声を受信するチャンネルのID
NOTIFY_CHANNEL_ID=      # 通知を送るチャンネルのID
CONNECT_NOTIFY=false    # 接続通知を送るかどうか
SILENT_MSG=true         # メッセージ送信時に通知を飛ばすかどうか

# NGワードをカンマ区切りで指定する。例: NG_WORD=あ,い,う
NG_WORDS=

# LOGの設定
LOG_FILE=detected.log                           # 検知のログファイル名。空欄にするとログを出力しない

# ASRの設定
SILENCE_SEC=1.0                                 # 無音と判定する秒数。これより長い無音が続くと音声受信が終了する
MIN_SEC=0.5                                     # 音声受信の最小秒数。これより短い音声は無視される
MAX_SEC=20.0                                    # 音声受信の最大秒数。これより長い音声は途中で切り捨てられる
MAX_PENDING=5                                   # 音声受信の最大待ち行列数。これを超えると音声受信が拒否される
WATCHDOG_SEC=30                                 # 音声受信の監視間隔。これを超えて音声が途切れると監視がリセットされる
ASR_THREADS=2                                   # CPUスレッド数。1コア空けておくと音声受信が安定する
STT_BACKEND=reazon                              # 文字起こしのバックエンド。reazon or whisper

# ReazonSpeechの設定
REAZON_MODEL=reazon-research/reazonspeech-k2-v2   # 文字起こしのモデルリポジトリID

# Whisperの設定
WHISPER_MODEL=small     # 文字起こしのモデルサイズ。tiny, base, small, medium, largeなど
WHISPER_DEVICE=cpu      # 文字起こしの実行デバイス。cpu or cuda
WHISPER_COMPUTE=int8    # 文字起こしの計算精度。int8 or float16