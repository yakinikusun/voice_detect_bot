# DISCORD側の設定
TOKEN=              # Discord Botのトークン
CHANNEL_ID=         # 音声を受信するチャンネルのID
NOTIFY_CHANNEL_ID=  # 通知を送るチャンネルのID
SILENT=true         # メッセージ送信時に通知を飛ばすかどうか

# ASRの設定
ASR_THREADS=2                                   # CPUスレッド数。1コア空けておくと音声受信が安定する
STT_BACKEND=reazon                              # 文字起こしのバックエンド。reazon or whisper

# ReazonSpeechの設定
MODEL_REPO=reazon-research/reazonspeech-k2-v2   # 文字起こしのモデルリポジトリID

# Whisperの設定
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8